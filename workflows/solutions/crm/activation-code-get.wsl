// GET /activation-codes/{id} — admin gets a single activation code by id.
// URL param: id. Returns the activation_code doc with 200.
// Provided by acme-crm package.

module activation_code_get

import persistence/store
import services/common

workflow activation_code_get {
  start: Get

  state Get {
    action persistence/store/store.Get(
      collection: "activation_codes",
      id: $url.id
    ) as Result
    on success -> OK
    on error -> GetFailed
  }

  state OK {
    action services/common/response.Response(
      value: $Result.response.doc,
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state GetFailed {
    action services/common/response.Response(
      value: { message: $Result.response.message, id: $url.id },
      statusCode: 404
    ) as ErrorResult
    end fail
  }
}
