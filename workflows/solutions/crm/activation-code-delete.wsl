// DELETE /activation-codes/{id} — admin deletes an activation code.
// URL param: id. Returns {deleted: true, id} with 200.
// Provided by acme-crm package.

module activation_code_delete

import persistence/store
import services/common

workflow activation_code_delete {
  start: Delete

  state Delete {
    action persistence/store/store.Delete(
      collection: "activation_codes",
      id: $url.id
    ) as Result
    on success -> OK
    on error -> DeleteFailed
  }

  state OK {
    action services/common/response.Response(
      value: { deleted: true, id: $url.id },
      statusCode: 200
    ) as FinalResult
    end ok
  }

  state DeleteFailed {
    action services/common/response.Response(
      value: { message: $Result.response.message, id: $url.id },
      statusCode: 500
    ) as ErrorResult
    end fail
  }
}
